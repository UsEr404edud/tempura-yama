{
  "id": "/",
  "name": "Tempura Yama — Totem de pedidos",
  "short_name": "Tempura Yama",
  "description": "Peça seu tempurá no totem, escolha a mesa e acompanhe o preparo em tempo real.",
  "lang": "pt-BR",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#fff9f0",
  "theme_color": "#16202b",
  "categories": ["food", "shopping", "lifestyle"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icons/icon-192.png",
