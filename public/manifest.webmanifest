      "url": "/#/pedido",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Painel da cozinha",
      "short_name": "Cozinha",
      "description": "Abrir a fila de pedidos da cozinha",
      "url": "/#/admin",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "screenshots": [
