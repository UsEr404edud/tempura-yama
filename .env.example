# Porta do servidor (o Render define automaticamente em produção)
PORT=3000

# PIN do painel da cozinha (troque em produção!)
ADMIN_PIN=2468

# Fuso horário usado para "pedidos de hoje"
TZ=America/Sao_Paulo

# Banco de dados:
# - Deixe DATABASE_URL vazio para usar SQLite local (./data/tempura.db)
# - No Render, o render.yaml injeta a URL do PostgreSQL automaticamente
# DATABASE_URL=postgres://usuario:senha@host:5432/banco

# Onde o SQLite guarda o arquivo (opcional)
# DATA_DIR=./data
